# 목업 모드 (기본값): API 키 없이 전체 상담 흐름 체험
# true(기본) = 오프라인 SVG 목업 이미지 + 서버 호출 시뮬레이션
# false = 실제 이미지 + 서버 프록시 호출 (아래 URL 필요)
VITE_MOCK_AI=true

# 실제 AI 연동용 서버 프록시 (브라우저에 키 노출 금지 — React -> Server -> GPT Image)
# 목업 모드에서는 사용하지 않습니다. 실연동 시:
# 1) VITE_MOCK_AI=false 로 변경
# 2) 아래 URL에 /generate, /edit POST를 받는 프록시 서버를 띄우기
# VITE_AI_PROXY_URL=http://localhost:8787/api/image
