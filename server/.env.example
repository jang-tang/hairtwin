# Hair Twin Server
PORT=8787
NODE_ENV=development

# SQLite 파일 경로 (:memory: = 휘발성 테스트용)
DB_PATH=./data/hairtwin.sqlite
# 서버 기동 시 데모 시드 자동 실행
SEED_DEMO=true

# JWT (운영에서는 반드시 긴 랜덤값으로 교체)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=14d

# mock = 키 없이 개발 가능 (기본). real = 실제 provider 사용
AUTH_PROVIDER=mock
AI_PROVIDER=mock
OPENAI_IMAGE_MODEL=gpt-image-1

# AI real provider용 (서버 전용. 프론트에 노출 금지)
# OPENAI_API_KEY=sk-...

# 허용 프론트 오리진 (콤마 구분)
CORS_ORIGIN=http://localhost:5173
