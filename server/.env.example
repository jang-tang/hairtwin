# Hair Twin Server
PORT=8787
NODE_ENV=development

# SQLite 파일 경로 (:memory: = 휘발성 테스트용)
DB_PATH=./data/hairtwin.sqlite
# sqlite (local) | postgres (Supabase). DATABASE_URL is server-only.
DB_PROVIDER=sqlite
# DATABASE_URL=postgresql://hairtwin_app.PROJECT_REF:PASSWORD@SESSION_POOLER_HOST:5432/postgres
# Optional Supabase CA certificate path; TLS certificate verification is always enabled.
# DATABASE_CA_PATH=./data/supabase-ca.crt
# PostgreSQL pool and query/transaction lock limits (milliseconds)
DB_POOL_MAX=5
DB_CONNECT_TIMEOUT_MS=15000
DB_STATEMENT_TIMEOUT_MS=30000
DB_LOCK_TIMEOUT_MS=10000
# 서버 기동 시 데모 시드 자동 실행
SEED_DEMO=true

# JWT (운영에서는 반드시 긴 랜덤값으로 교체)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=14d

# mock = 키 없이 개발 가능 (기본). real = 실제 provider 사용
AUTH_PROVIDER=mock
AI_PROVIDER=mock
OPENAI_IMAGE_MODEL=gpt-image-1

# AI real provider용 (서버 전용. 프론트에 노출 금지)
# OPENAI_API_KEY=sk-...

# 허용 프론트 오리진 (콤마 구분)
CORS_ORIGIN=http://localhost:5173
